# Backend server port
PORT=3001

# Required by SEC EDGAR usage policy: identify your app and contact info
SEC_USER_AGENT=SEC EDGAR Filing Explorer (contact@example.com)

# SEC request timeout in milliseconds
SEC_REQUEST_TIMEOUT_MS=10000

# Company metadata cache TTL in milliseconds
SEC_COMPANIES_CACHE_TTL_MS=3600000

# Max concurrent SEC historical submissions fetches
SEC_HISTORICAL_FETCH_CONCURRENCY=4
